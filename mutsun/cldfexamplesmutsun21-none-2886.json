        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">utten</div>\n\t\t<div class=\"glossblock\">doctor, sorcerer, medicineman</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">huska-hne</div>\n\t\t<div class=\"glossblock\">suck out an illness-passive</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">nuk</div>\n\t\t<div class=\"glossblock\">him, her, it</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">men</div>\n\t\t<div class=\"glossblock\">you</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">wire-hne</div>\n\t\t<div class=\"glossblock\">fan smoke-passive</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">nuk</div>\n\t\t<div class=\"glossblock\">him, her, it</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">men</div>\n\t\t<div class=\"glossblock\">you</div>\n\t</div>\n</div>\n",
