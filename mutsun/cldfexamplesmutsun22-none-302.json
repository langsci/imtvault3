        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">diyos</div>\n\t\t<div class=\"glossblock\">God</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">aTi</div>\n\t\t<div class=\"glossblock\">without, no</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">yumme-paN</div>\n\t\t<div class=\"glossblock\">deceive, lie-one who overdoes</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ussi</div>\n\t\t<div class=\"glossblock\">why, because</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">wak</div>\n\t\t<div class=\"glossblock\">he/she/it</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">monse-s</div>\n\t\t<div class=\"glossblock\">tell, say-past tense</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">himyu</div>\n\t\t<div class=\"glossblock\">all</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">essehtis-e</div>\n\t\t<div class=\"glossblock\">Christian-objective</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">numan</div>\n\t\t<div class=\"glossblock\">that, which, who, where</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">*aama-ni=ne</div>\n\t\t<div class=\"glossblock\">believe-mediopass.=this</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">niSSa-sum</div>\n\t\t<div class=\"glossblock\">this-with, by means of</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kan</div>\n\t\t<div class=\"glossblock\">I</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">*aama-n</div>\n\t\t<div class=\"glossblock\">believe-mediopass.</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">wak</div>\n\t\t<div class=\"glossblock\">he/she/it</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">hiSSe-s</div>\n\t\t<div class=\"glossblock\">m