        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kaatYi</div>\n\t\t<div class=\"glossblock\">thus, like this</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kan</div>\n\t\t<div class=\"glossblock\">I</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">suuti</div>\n\t\t<div class=\"glossblock\">wait, hope</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ussi</div>\n\t\t<div class=\"glossblock\">why, because</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kan=mes</div>\n\t\t<div class=\"glossblock\">I=you (obj.)</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">diyos</div>\n\t\t<div class=\"glossblock\">God</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">miS-min</div>\n\t\t<div class=\"glossblock\">be good-one who does/is X</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kaatYi=kus=me</div>\n\t\t<div class=\"glossblock\">thus, like this=past=you</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kuwa-s</div>\n\t\t<div class=\"glossblock\">say, tell-past tense</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ara</div>\n\t\t<div class=\"glossblock\">then, and then, next</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">me-t</div>\n\t\t<div class=\"glossblock\">you-if it were, if only, if, might</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">miSSi-mak-se</div>\n\t\t<div class=\"glossblock\">be good-plural nominalizer-objective</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">neppe-sum</div>\n\t\t<div class=\"glossblock\">this-with, by means of</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kan</div>\n\t\t<div class=\"glossblock\">I</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">naha</div>