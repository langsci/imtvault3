        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">Taares-mak</div>\n\t\t<div class=\"glossblock\">man, male-plural</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">watti-n</div>\n\t\t<div class=\"glossblock\">go, go away-mediopass.</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">tuupen-tak</div>\n\t\t<div class=\"glossblock\">sweathouse, roundhouse-at, in, to, on</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">amSi</div>\n\t\t<div class=\"glossblock\">so that, in order to</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">haysa</div>\n\t\t<div class=\"glossblock\">they</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">Talla-pu</div>\n\t\t<div class=\"glossblock\">be hot, sweat, lie in sun-to oneself</div>\n\t</div>\n</div>\n",
