        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kan=amisan</div>\n\t\t<div class=\"glossblock\">my=lord</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">hesu</div>\n\t\t<div class=\"glossblock\">Jesus</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kristus</div>\n\t\t<div class=\"glossblock\">Christ</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">diyos</div>\n\t\t<div class=\"glossblock\">God</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">Taares</div>\n\t\t<div class=\"glossblock\">man, male</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ya</div>\n\t\t<div class=\"glossblock\">and, also, too</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">himme-n-tak</div>\n\t\t<div class=\"glossblock\">mix, join-nominalizer-at, in, to, on</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">mokko-ni-smak</div>\n\t\t<div class=\"glossblock\">be born, sprout, come up-mediopass.-one who does X often</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">rehwe-mpi-smak</div>\n\t\t<div class=\"glossblock\">be redeemed-make, cause, let-one who does X often</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ya</div>\n\t\t<div class=\"glossblock\">and, also, too</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kannis</div>\n\t\t<div class=\"glossblock\">me</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ussi</div>\n\t\t<div class=\"glossblock\">why, because</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">men</div>\n\t\t<div class=\"glossblock\">you</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">at</div>\n\t\t<div class=\"glossblock\">shortly, already, just</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">miS-m