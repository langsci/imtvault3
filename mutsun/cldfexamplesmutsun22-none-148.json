        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">himpes-um</div>\n\t\t<div class=\"glossblock\">sign, signal-with, by means of</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">santa krus</div>\n\t\t<div class=\"glossblock\">holy cross</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">nossow</div>\n\t\t<div class=\"glossblock\">breath, spirit, life</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">waayas</div>\n\t\t<div class=\"glossblock\">enemy</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kalle</div>\n\t\t<div class=\"glossblock\">defend</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">maksen</div>\n\t\t<div class=\"glossblock\">us</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">diyos</div>\n\t\t<div class=\"glossblock\">God</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">makke</div>\n\t\t<div class=\"glossblock\">our</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">amisan</div>\n\t\t<div class=\"glossblock\">lord</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">appa</div>\n\t\t<div class=\"glossblock\">father</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">raakat</div>\n\t\t<div class=\"glossblock\">name</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">innis</div>\n\t\t<div class=\"glossblock\">son</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ya</div>\n\t\t<div class=\"glossblock\">and, also, too</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">espiritu</div>\n\t\t<div class=\"glossblock\">spirit</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">santi</div>\n\t\t<div class=\"glossblock\">holy one, saint</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">y