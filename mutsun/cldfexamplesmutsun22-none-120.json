        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">makam</div>\n\t\t<div class=\"glossblock\">you all</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">piNi</div>\n\t\t<div class=\"glossblock\">perhaps, maybe</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">hinsu</div>\n\t\t<div class=\"glossblock\">know</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">haysa</div>\n\t\t<div class=\"glossblock\">they</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">wuuTa-ti</div>\n\t\t<div class=\"glossblock\">relative, owner, patron-be X</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ene</div>\n\t\t<div class=\"glossblock\">and, but</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">makam</div>\n\t\t<div class=\"glossblock\">you all</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">haysane</div>\n\t\t<div class=\"glossblock\">them</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">nottYo</div>\n\t\t<div class=\"glossblock\">deny</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ekTe-Ste</div>\n\t\t<div class=\"glossblock\">be evil, be bad-perfective</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">urhe-hne</div>\n\t\t<div class=\"glossblock\">take a wife/husband-passive</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">*uTTa-pu</div>\n\t\t<div class=\"glossblock\">take care of, wait for-to oneself</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">diyos</div>\n\t\t<div class=\"glossblock\">God</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">ekwe</div>\n\t\t<div class=\"glossblock\">not, no</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">uuni</div>\n\t\t<div class=\"glossblock\">want</div>\n\t</div>\n\t<div clas