        "html": "<div class=\"imtblocks\">\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">Tarah-tak-was</div>\n\t\t<div class=\"glossblock\">sky, heaven-at, in, to, on-from, of</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">innu</div>\n\t\t<div class=\"glossblock\">road, door</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">minwa-hte</div>\n\t\t<div class=\"glossblock\">be narrow-perfective</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kuynu-hte</div>\n\t\t<div class=\"glossblock\">be crooked-perfective</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kayTi-Smin</div>\n\t\t<div class=\"glossblock\">tighten-one who does/is X</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">wittu-Smin</div>\n\t\t<div class=\"glossblock\">break-one who does/is X</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">warci-Smin</div>\n\t\t<div class=\"glossblock\">be narrow-one who does/is X</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kaatYi</div>\n\t\t<div class=\"glossblock\">thus, like this</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">at</div>\n\t\t<div class=\"glossblock\">shortly, already, just</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">nahan</div>\n\t\t<div class=\"glossblock\">there</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">was-mak</div>\n\t\t<div class=\"glossblock\">he/she/it...him/her/it-plural</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">kuwa</div>\n\t\t<div class=\"glossblock\">say, tell</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">diyos</div>\n\t\t<div class=\"glossblock\">God</div>\n\t</div>\n\t<div class=\"imtblock\">\n\t\t<div class=\"srcblock\">asa'a</div>\n\t\t<div class=\"glossblock\">truly, really, true, truth</div>\n\t</div>\n</div>\n",
